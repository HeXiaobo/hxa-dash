# ============================================
# hxa-dash Environment Configuration
# ============================================

# Node environment
NODE_ENV=development

# Server port
PORT=3479

# ============================================
# Feishu OAuth Configuration
# ============================================

# Feishu bot app credentials (get from Feishu Admin Console)
# App ID: cli_a940cff668b81bde (Mylos bot)
FEISHU_APP_ID=your_feishu_app_id
FEISHU_APP_SECRET=your_feishu_app_secret

# Zhiwai's tenant key (for access control - only allow Zhiwai employees)
# This is the tenant_key returned from Feishu OAuth
FEISHU_TENANT_KEY=your_zhiwai_tenant_key

# ============================================
# JWT Authentication
# ============================================

# Secret key for signing JWT tokens (use a random 32+ character string)
# Generate with: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_change_in_production

# Dedicated per-agent machine-ingest keys for minimized near-real-time
# Dashboard state. Keep separate from HEALTH_API_KEY. Each key is accepted
# only on its matching /api/agent-state/:name route.
DASHBOARD_STATE_INGEST_KEYS_JSON={"yueran":"replace_with_yueran_ingest_key"}

# Single-agent compatibility form. Both values are required together and the
# key is accepted only for the bound agent name. Do not configure this together
# with DASHBOARD_STATE_INGEST_KEYS_JSON.
# DASHBOARD_STATE_INGEST_AGENT_NAME=yueran
# DASHBOARD_STATE_INGEST_API_KEY=replace_with_single_agent_ingest_key

# ============================================
# GitLab & Connect Configuration
# ============================================

# See config/sources.example.json for data source configuration
